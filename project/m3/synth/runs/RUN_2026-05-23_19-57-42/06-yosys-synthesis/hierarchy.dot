n9 [ shape=octagon, label="aresetn", color="black", fontcolor="black"];
n10 [ shape=octagon, label="aclk", color="black", fontcolor="black"];
c11 [ shape=record, label="{{<p10> aclk|<p9> aresetn|<p2> m_axis_tready|<p8> s_axis_tdata|<p5> s_axis_tlast|<p7> s_axis_tvalid}|cnn_mac_wrapper\naxis_interface|{<p4> m_axis_tdata|<p1> m_axis_tlast|<p3> m_axis_tvalid|<p6> s_axis_tready}}",  ];
c11:p1:e -> n1:w [color="black", fontcolor="black", label=""];
